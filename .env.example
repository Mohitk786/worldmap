# Plain Postgres: same value for both. Supabase/PgBouncer-style hosts: DATABASE_URL
# is the pooled connection (used by the running app), DIRECT_URL is the direct/session
# connection (used only by Prisma CLI for migrations — pooled transaction-mode
# connections don't support the advisory locks migrations need).
DATABASE_URL="postgresql://worldmap:worldmap@localhost:5470/worldmap?schema=public"
DIRECT_URL="postgresql://worldmap:worldmap@localhost:5470/worldmap?schema=public"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Single source of truth for the brand everywhere in the app (header, page
# titles, footer, OG images, emails). Change this one value to rebrand.
NEXT_PUBLIC_SITE_NAME="WorldMap"
NEXT_PUBLIC_SITE_TAGLINE="Claim a country. Literally."

# Dodo Payments test-mode keys — https://app.dodopayments.com (Developer > API Keys)
DODO_PAYMENTS_API_KEY=""
DODO_PAYMENTS_ENVIRONMENT="test_mode"
# Id of the one-time "country stake" product configured with dynamic/custom pricing
DODO_PRODUCT_ID=""
# From Dashboard > Developer > Webhooks, once the endpoint pointing at /api/webhooks/dodo is created
DODO_PAYMENTS_WEBHOOK_SECRET=""

ADMIN_PASSWORD="change-me"
ADMIN_SESSION_SECRET="change-me-too"

# Header's "N watching now" badge — https://datafa.st Website Settings > API tab.
# Leave unset to hide the badge entirely (no error, it just won't render).
DATAFAST_API_KEY=""
